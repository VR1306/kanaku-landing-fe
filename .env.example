# Login / signup pages of the separate user app (absolute URLs, required).
USER_APP_LOGIN_URL=https://growwithkanaku-user.vercel.app/login
USER_APP_SIGNUP_URL=https://growwithkanaku-user.vercel.app/signup
# Landing content source (optional). When unset, the bundled default config is used.
LANDING_API_URL=
LANDING_API_TOKEN=
# Outbound request timeout in milliseconds.
API_TIMEOUT_MS=8000
# Bearer secret required by POST /api/revalidate (min 16 chars). Leave empty to disable.
REVALIDATE_SECRET=
# Public canonical URL, used for SEO metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
